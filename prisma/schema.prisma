generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════════════════
// Company (企業)
// ════════════════════════════════════════════════════════════════════

model Company {
  id        String   @id @default(cuid())
  name      String
  url       String?
  industry  String?
  employeeCount String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessProcesses BusinessProcess[]
  personalInfoItems PersonalInfoItem[]
  dataSubjects      DataSubject[]
  storageLocations  StorageLocation[]
  thirdParties      ThirdParty[]
  agentSessions     AgentSession[]
  documents         Document[]
}

// ════════════════════════════════════════════════════════════════════
// BusinessProcess (業務プロセス)
// ════════════════════════════════════════════════════════════════════

model BusinessProcess {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  department  String?
  description String?
  createdBySession String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bpPiis    BusinessProcessPII[]

  @@unique([companyId, name])
}

// ════════════════════════════════════════════════════════════════════
// PersonalInfoItem (個人情報項目 — 名寄せされた実体)
// ════════════════════════════════════════════════════════════════════

model PersonalInfoItem {
  id            String   @id @default(cuid())
  companyId     String
  canonicalName String
  aliases       String   @default("[]") // JSON array
  isSensitive   Boolean  @default(false) // 要配慮個人情報フラグ
  createdAt     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bpPiis  BusinessProcessPII[]

  @@unique([companyId, canonicalName])
}

// ════════════════════════════════════════════════════════════════════
// DataSubject (データ主体)
// ════════════════════════════════════════════════════════════════════

model DataSubject {
  id        String   @id @default(cuid())
  companyId String
  name      String // 顧客, 従業員, 応募者, etc.
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bpPiis  BusinessProcessPII[]

  @@unique([companyId, name])
}

// ════════════════════════════════════════════════════════════════════
// StorageLocation (保管場所)
// ════════════════════════════════════════════════════════════════════

model StorageLocation {
  id        String   @id @default(cuid())
  companyId String
  name      String
  type      String?  // cloud_saas | on_premise | paper | external_service
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bpPiis  BusinessProcessPII[]

  @@unique([companyId, name])
}

// ════════════════════════════════════════════════════════════════════
// ThirdParty (第三者提供先・委託先)
// ════════════════════════════════════════════════════════════════════

model ThirdParty {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  role            String?  // third_party | subcontractor
  contractStatus  String   @default("unconfirmed") // confirmed | unconfirmed
  createdAt       DateTime @default(now())

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bpPiiThirdParties BpPiiThirdParty[]

  @@unique([companyId, name])
}

// ════════════════════════════════════════════════════════════════════
// BusinessProcessPII (業務×個人情報 リレーション — 核テーブル)
// ════════════════════════════════════════════════════════════════════

model BusinessProcessPII {
  id                  String   @id @default(cuid())
  businessProcessId   String
  personalInfoItemId  String
  dataSubjectId       String?
  storageLocationId   String?

  // フィールド値
  purpose             String?
  acquisitionMethod   String?
  accessSubjects      String?  // JSON array
  retentionPeriod     String?
  disposalMethod      String?
  volumeEstimate      String?

  // フィールド単位の確信度ステータス
  purposeStatus           String @default("unconfirmed")
  acquisitionMethodStatus String @default("unconfirmed")
  storageStatus           String @default("unconfirmed")
  accessSubjectsStatus    String @default("unconfirmed")
  retentionPeriodStatus   String @default("unconfirmed")
  disposalMethodStatus    String @default("unconfirmed")
  volumeEstimateStatus    String @default("unconfirmed")
  thirdPartyStatus        String @default("unconfirmed")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessProcess  BusinessProcess  @relation(fields: [businessProcessId], references: [id], onDelete: Cascade)
  personalInfoItem PersonalInfoItem @relation(fields: [personalInfoItemId], references: [id], onDelete: Cascade)
  dataSubject      DataSubject?     @relation(fields: [dataSubjectId], references: [id])
  storageLocation  StorageLocation? @relation(fields: [storageLocationId], references: [id])

  thirdParties     BpPiiThirdParty[]
  evidences        Evidence[]
  riskAssessments  RiskAssessment[]
  fieldChangeLogs  FieldChangeLog[]
  questionLinks    QuestionBpPii[]
}

// 多対多中間テーブル: BusinessProcessPII × ThirdParty
model BpPiiThirdParty {
  id           String @id @default(cuid())
  bpPiiId      String
  thirdPartyId String

  bpPii      BusinessProcessPII @relation(fields: [bpPiiId], references: [id], onDelete: Cascade)
  thirdParty ThirdParty         @relation(fields: [thirdPartyId], references: [id], onDelete: Cascade)

  @@unique([bpPiiId, thirdPartyId])
}

// ════════════════════════════════════════════════════════════════════
// Evidence (証跡)
// ════════════════════════════════════════════════════════════════════

model Evidence {
  id            String   @id @default(cuid())
  bpPiiId       String?
  riskId        String?
  targetField   String   // どのフィールドの根拠か (e.g. "retentionPeriod")
  sourceType    String   // file | web | questionnaire
  sourceRef     String   // ファイル名 or URL
  detail        String?  // 該当箇所の説明
  capturedAt    DateTime @default(now())
  snapshotS3Key String?  // S3に保存したWebスナップショットのkey
  createdBy     String   @default("agent") // agent | human

  bpPii          BusinessProcessPII? @relation(fields: [bpPiiId], references: [id], onDelete: Cascade)
  riskAssessment RiskAssessment?     @relation(fields: [riskId], references: [id], onDelete: Cascade)
}

// ════════════════════════════════════════════════════════════════════
// RiskAssessment (リスク評価)
// ════════════════════════════════════════════════════════════════════

model RiskAssessment {
  id                  String   @id @default(cuid())
  bpPiiId             String
  threat              String
  vulnerability       String
  likelihood          String   // high | medium | low
  impact              String   // high | medium | low
  riskScore           Int?     // computed
  currentMeasures     String?
  recommendedMeasures String?
  residualRisk        String?
  confidence          String   @default("unconfirmed")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  bpPii     BusinessProcessPII @relation(fields: [bpPiiId], references: [id], onDelete: Cascade)
  evidences Evidence[]
}

// ════════════════════════════════════════════════════════════════════
// Question (確認依頼)
// ════════════════════════════════════════════════════════════════════

model Question {
  id             String   @id @default(cuid())
  sessionId      String
  questionText   String
  questionType   String   // single_choice | multiple_choice | yes_no | free_text
  options        String?  // JSON array
  relatedFields  String?  // JSON array of field names
  priority       String   // critical | important | nice_to_have
  context        String?
  status         String   @default("pending") // pending | answered | skipped | escalated
  answer         String?
  answeredAt     DateTime?
  answeredBy     String?
  askCount       Int      @default(1)
  createdAt      DateTime @default(now())

  session       AgentSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  bpPiiLinks    QuestionBpPii[]
}

// 多対多中間テーブル: Question × BusinessProcessPII
model QuestionBpPii {
  id         String @id @default(cuid())
  questionId String
  bpPiiId    String

  question Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  bpPii    BusinessProcessPII @relation(fields: [bpPiiId], references: [id], onDelete: Cascade)

  @@unique([questionId, bpPiiId])
}

// ════════════════════════════════════════════════════════════════════
// Document (生成文書)
// ════════════════════════════════════════════════════════════════════

model Document {
  id               String    @id @default(cuid())
  companyId        String
  type             String    // personal_info_registry | risk_analysis | business_process_list
  version          Int       @default(1)
  filePath         String    // S3 key or local path
  fileFormat       String    // xlsx | docx | csv
  summary          String?
  confirmedCount   Int       @default(0)
  estimatedCount   Int       @default(0)
  unconfirmedCount Int       @default(0)
  totalFields      Int       @default(0)
  generatedAt      DateTime  @default(now())
  approvedBy       String?
  approvedAt       DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ════════════════════════════════════════════════════════════════════
// FieldChangeLog (フィールド変更履歴)
// ════════════════════════════════════════════════════════════════════

model FieldChangeLog {
  id        String   @id @default(cuid())
  bpPiiId   String
  fieldName String
  oldValue  String?
  newValue  String?
  oldStatus String?
  newStatus String?
  changedBy String   // agent | human:名前
  trigger   String   // discovery | question_answer | manual_edit | re_discovery
  changedAt DateTime @default(now())

  bpPii BusinessProcessPII @relation(fields: [bpPiiId], references: [id], onDelete: Cascade)
}

// ════════════════════════════════════════════════════════════════════
// AgentSession (エージェントセッション)
// ════════════════════════════════════════════════════════════════════

model AgentSession {
  id                  String   @id @default(cuid())
  companyId           String
  anthropicSessionId  String?  @unique
  status              String   @default("running") // running | idle | waiting_for_answers | completed
  phase               String   @default("discovery") // discovery | gap_analysis | drafting | review
  webAccessLog        String   @default("[]") // JSON array of {url, method, timestamp}
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  questions Question[]
}
